# Copy to .env.local (git-ignored) and fill in. All optional, all read at build time — writers never see or set them.
# Without them Page One still writes, exports and passes drafts; live co-writing, Drive and TMDb stills switch off.

# Live co-writing and phone sync: the same three values as collab.properties in the PageOne Android project.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=

# Real film frames for the daily still on the home screen (themoviedb.org › Settings › API). Same as tmdbKey on the phone.
VITE_TMDB_KEY=

# Google Drive: an OAuth client ID (Google Cloud › APIs & Services › Credentials › OAuth client ID › Web application).
# Add http://localhost:47823 under Authorised redirect URIs (the desktop app signs in through your browser),
# add http://localhost:5173 as an authorised JavaScript origin (for running in a browser), and enable the Drive API.
VITE_GOOGLE_CLIENT_ID=
